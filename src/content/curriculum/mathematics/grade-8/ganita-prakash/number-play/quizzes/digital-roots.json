          "marks": 1
        },
        {
          "id": "q-drp-3",
          "type": "mcq",
          "prompt": "A number's digits add to 33. What is its digital root?",
          "options": [
            { "id": "a", "text": "33" },
            { "id": "b", "text": "6" },
            { "id": "c", "text": "9" },
            { "id": "d", "text": "3" }
          ],
          "correctOptionId": "b",
          "explanation": "3 + 3 = 6, so the digital root is 6 — and the number leaves remainder 6 modulo 9.",
          "difficulty": 1,
          "marks": 1
        }
      ],
