      "instructions": "Set up the digit-sum condition, then solve for the missing digit.",
      "questions": [
        {
          "id": "q-drp-1",
          "type": "mcq",
          "prompt": "2,84★ must be divisible by 9. What is ★?",
          "options": [
            { "id": "a", "text": "2" },
            { "id": "b", "text": "4" },
            { "id": "c", "text": "6" },
            { "id": "d", "text": "8" }
          ],
          "correctOptionId": "b",
          "explanation": "2 + 8 + 4 = 14, and the next multiple of 9 is 18, so ★ = 4. The other choices give digit sums 16, 20 and 22 — none divisible by 9.",
          "difficulty": 2,
          "marks": 1
        },
        {
          "id": "q-drp-2",
          "type": "mcq",
          "prompt": "Which number has digital root 1?",
          "options": [
            { "id": "a", "text": "154" },
            { "id": "b", "text": "263" },
            { "id": "c", "text": "348" },
            { "id": "d", "text": "471" }
          ],
          "correctOptionId": "a",
          "explanation": "154: 1 + 5 + 4 = 10 → 1 ✓. The others reduce to 2 (263), 6 (348) and 3 (471).",
